      {
        "name": "update_recipe",
        "title": "Update Recipe",
        "description": "Edit a recipe: text/SEO fields, ingredients, steps, nutrition, servings and times. Send the FULL list for any array field you change (it replaces the old list). Saves a rollback version first and returns the new SEO score.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "subtitle": {
              "type": "string",
              "maxLength": 300
            },
            "description": {
              "type": "string",
              "maxLength": 5000
            },
            "seo_title": {
              "type": "string",
              "maxLength": 120
            },
            "seo_description": {
              "type": "string",
              "maxLength": 320
            },
            "pinterest_description": {
              "type": "string",
              "maxLength": 800
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "tips": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 600
              },
              "maxItems": 10
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "maxItems": 30
            },
            "ingredients": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "object",
                    "properties": {
                      "group": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 120
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "minItems": 1,
                        "maxItems": 60
                      }
                    },
                    "required": [
                      "items"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 40,
              "description": "Plain lines like '200 g extra-firm tofu' or groups {group, items}"
            },
            "instructions": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 2000
                  },
                  {
                    "type": "object",
                    "properties": {
                      "title": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "body": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 2000
                      },
                      "image_url": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "body"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 40,
              "description": "Steps; keep existing image_url values to preserve step photos"
            },
            "nutrition": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 20,
              "description": "Per-serving rows like {label:'Protein', value:'24 g'}"
            },
            "servings": {
              "type": "string",
              "maxLength": 60
            },
            "prep_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "cook_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "difficulty": {
              "type": "string",
              "maxLength": 40
            },
            "keyword": {
              "type": "string",
              "maxLength": 120,
              "description": "Focus keyword used for the returned SEO score"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
