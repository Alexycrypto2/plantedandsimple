      {
        "name": "create_draft",
        "title": "Create Draft",
        "description": "Create a new blog post as an unpublished draft.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "content": {
              "type": "string",
              "maxLength": 200000,
              "default": ""
            },
            "excerpt": {
              "type": "string",
              "maxLength": 500
            },
            "category": {
              "type": "string",
              "maxLength": 80
            },
            "meta_title": {
              "type": "string",
              "maxLength": 120
            },
            "meta_description": {
              "type": "string",
              "maxLength": 320
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_post",
        "title": "Update Post",
        "description": "Update a blog post (title, content, meta title/description, slug, headings, alt text, internal links). The previous version is saved first for rollback.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "content": {
              "type": "string",
              "maxLength": 200000
            },
            "meta_title": {
              "type": "string",
              "maxLength": 120
            },
            "meta_description": {
              "type": "string",
              "maxLength": 320
            },
            "excerpt": {
              "type": "string",
              "maxLength": 600
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            "headings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "alt_text": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "internal_links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "anchor": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "href": {
                    "type": "string",
                    "pattern": "^\\/[a-z0-9\\-/]*$"
                  }
                },
                "required": [
                  "anchor",
                  "href"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
